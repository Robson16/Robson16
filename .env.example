# Public site URL for canonical and Open Graph metadata
SITE_URL="http://localhost:3000"

# Database
DATABASE_URL="postgresql://postgres:docker@localhost:5432/portfolio?schema=public"

# Google Tag Manager
GOOGLE_TAG_ID=GTM-XXXXXXXX

# GitLab
GITLAB_ACCESS_TOKEN="glpat-seu_token_aqui"
GITLAB_USERNAME="seu_usuario_gitlab"

# GitHub
GITHUB_ACCESS_TOKEN="ghp_seu_token_aqui"
GITHUB_USERNAME="seu_usuario_github"

# GitHub Auth
ALLOWED_EMAIL="johndoe@example.com"
NEXTAUTH_SECRET="gere-uma-string-aleatoria-bem-segura-aqui"
NEXTAUTH_GITHUB_ID="seu_client_id_do_github"
NEXTAUTH_GITHUB_SECRET="seu_client_secret_do_github"

# Cloudflare R2 / MinIO Local
CLOUDFLARE_ENDPOINT="http://localhost:9000"
CLOUDFLARE_ACCESS_KEY_ID="admin"
CLOUDFLARE_SECRET_ACCESS_KEY="password123"
CLOUDFLARE_BUCKET_NAME="portfolio"
CLOUDFLARE_PUBLIC_URL="http://localhost:9000/portfolio"